 import sqlite3
+from contextlib import contextmanager
+from datetime import date
+
+SCHEMA_VERSION = 2
+
+
+@contextmanager
+def _tx(conn):
+    conn.execute("BEGIN")
+    try:
+        yield conn
+        conn.commit()
+    except BaseException:
+        conn.rollback()
+        raise
+
+
+def _table_exists(conn, name):
+    return (
+        conn.execute(
+            "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", (name,)
+        ).fetchone()
+        is not None
+    )
+
+
+def _schema_version(conn):
+    if _table_exists(conn, "schema_version"):
+        return conn.execute("SELECT version FROM schema_version LIMIT 1").fetchone()[0]
+    # A database with a tasks table but no schema_version table is from the
+    # current release: that is version 1.
+    return 1 if _table_exists(conn, "tasks") else 0
+
+
+def _migrate_to_v1(conn):
+    with _tx(conn):
+        conn.execute(
+            "CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+            "done INTEGER NOT NULL DEFAULT 0)"
+        )
+        conn.execute("CREATE TABLE schema_version (version INTEGER NOT NULL)")
+        conn.execute("INSERT INTO schema_version (version) VALUES (1)")
+
+
+def _migrate_to_v2(conn):
+    with _tx(conn):
+        conn.execute("ALTER TABLE tasks ADD COLUMN due_date TEXT")
+        if _table_exists(conn, "schema_version"):
+            conn.execute("UPDATE schema_version SET version = 2")
+        else:
+            conn.execute("CREATE TABLE schema_version (version INTEGER NOT NULL)")
+            conn.execute("INSERT INTO schema_version (version) VALUES (2)")
+
+
+_MIGRATIONS = {1: _migrate_to_v2}
+
+
+def _migrate(conn):
+    version = _schema_version(conn)
+    if version == 0:
+        _migrate_to_v1(conn)
+        version = 1
+    while version < SCHEMA_VERSION:
+        _MIGRATIONS[version](conn)
+        version += 1
 
 
