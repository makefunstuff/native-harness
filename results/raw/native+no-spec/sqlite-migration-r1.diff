+import os, sqlite3, tempfile, unittest
+import todo
+
+
+class NewDbTest(unittest.TestCase):
+    def test_new_database_is_version_2(self):
+        d = tempfile.mkdtemp()
+        conn = todo.open_db(os.path.join(d, "t.db"))
+        self.assertEqual(conn.execute("SELECT version FROM schema_version").fetchone()[0], 2)
+        cols = {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}
+        self.assertEqual(cols, {"id", "title", "done", "due_date"})
+
+    def test_opening_migrated_db_changes_nothing(self):
+        d = tempfile.mkdtemp()
+        path = os.path.join(d, "t.db")
+        conn = todo.open_db(path)
+        todo.add_task(conn, "a", "2026-01-01")
+        before = conn.execute("SELECT sql FROM sqlite_master").fetchall()
+        conn.close()
+        conn = todo.open_db(path)
+        self.assertEqual(conn.execute("SELECT version FROM schema_version").fetchone()[0], 2)
+        self.assertEqual(before, conn.execute("SELECT sql FROM sqlite_master").fetchall())
+        self.assertEqual([t["title"] for t in todo.list_tasks(conn)], ["a"])
+
+
+class LegacyDbTest(unittest.TestCase):
+    def _make_legacy_db(self, path):
+        conn = sqlite3.connect(path)
+        conn.execute(
+            "CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+            "done INTEGER NOT NULL DEFAULT 0)"
+        )
+        conn.executemany("INSERT INTO tasks (title, done) VALUES (?, ?)",
+                         [("old one", 0), ("old two", 1)])
+        conn.commit()
+        conn.close()
+
+    def test_legacy_database_migrated_in_place(self):
+        d = tempfile.mkdtemp()
+        path = os.path.join(d, "legacy.db")
+        self._make_legacy_db(path)
+        conn = todo.open_db(path)
+        self.assertEqual(conn.execute("SELECT version FROM schema_version").fetchone()[0], 2)
+        tasks = todo.list_tasks(conn)
+        self.assertEqual([t["title"] for t in tasks], ["old one", "old two"])
+        self.assertEqual([t["done"] for t in tasks], [False, True])
+        self.assertEqual([t["due_date"] for t in tasks], [None, None])
+
+    def test_legacy_db_can_be_opened_again(self):
+        d = tempfile.mkdtemp()
+        path = os.path.join(d, "legacy.db")
+        self._make_legacy_db(path)
+        todo.open_db(path).close()
+        conn = todo.open_db(path)
+        self.assertEqual(conn.execute("SELECT version FROM schema_version").fetchone()[0], 2)
+        self.assertEqual(len(todo.list_tasks(conn)), 2)
+
+
+class DueDateTest(unittest.TestCase):
+    def setUp(self):
+        d = tempfile.mkdtemp()
+        self.conn = todo.open_db(os.path.join(d, "t.db"))
+
+    def test_add_task_with_due_date(self):
+        todo.add_task(self.conn, "pay rent", "2026-03-01")
+        t = todo.list_tasks(self.conn)[0]
+        self.assertEqual(t["title"], "pay rent")
+        self.assertEqual(t["due_date"], "2026-03-01")
+
+    def test_add_task_no_due_date(self):
+        todo.add_task(self.conn, "no date")
+        self.assertIsNone(todo.list_tasks(self.conn)[0]["due_date"])
+
+    def test_invalid_due_date_rejected(self):
+        for bad in ("2026-3-1", "20260301", "03-01-2026", "2026-02-30",
+                    "not-a-date", "2026-03-01T00:00", 20260301, "2026-03-01 "):
+            before = len(todo.list_tasks(self.conn))
+            with self.assertRaises(ValueError):
+                todo.add_task(self.conn, "bad", bad)
+            self.assertEqual(len(todo.list_tasks(self.conn)), before)
+
+    def test_overdue(self):
+        todo.add_task(self.conn, "later", "2026-03-02")
+        todo.add_task(self.conn, "same day a", "2026-03-01")
+        todo.add_task(self.conn, "today only", "2026-03-10")
+        todo.add_task(self.conn, "future", "2026-04-01")
+        todo.add_task(self.conn, "done and old", "2026-01-01")
+        done_id = self.conn.execute("SELECT id FROM tasks WHERE title = 'done and old'").fetchone()[0]
+        todo.complete(self.conn, done_id)
+        todo.add_task(self.conn, "no date at all")
+        self.assertEqual(todo.overdue(self.conn, "2026-03-10"), ["same day a", "later"])
+
+    def test_overdue_orders_by_due_date_then_id(self):
+        a = todo.add_task(self.conn, "b first", "2026-03-05")
+        b = todo.add_task(self.conn, "a second", "2026-03-05")
+        c = todo.add_task(self.conn, "earliest", "2026-03-01")
+        ids = {a: "b first", b: "a second", c: "earliest"}
+        self.assertEqual(todo.overdue(self.conn, "2026-03-31"),
+                         [ids[c], ids[a], ids[b]])
+
+
+if __name__ == "__main__":
+    unittest.main()
