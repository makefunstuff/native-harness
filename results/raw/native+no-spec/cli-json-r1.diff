+def parse_rows(rows, min_qty):
+    """Parse and filter CSV rows.
+
+    Returns a list of dicts with keys name (str), qty (int) and price (float).
+    Rows whose qty or price cannot be parsed are skipped with a warning on
+    stderr (1-based data row number).
+    """
+    out = []
+    for i, r in enumerate(rows, start=1):
+        try:
+            qty = int(r["qty"])
+            price = float(r["price"])
+        except (KeyError, TypeError, ValueError):
+            print(f"skipping row {i}: unparseable qty/price", file=sys.stderr)
+            continue
+        if qty < min_qty:
+            continue
+        out.append({"name": r["name"], "qty": qty, "price": price})
+    return out
+
+
 def main(argv=None):
     ap = argparse.ArgumentParser(description="Report stock levels")
     ap.add_argument("csv")
     ap.add_argument("--min-qty", type=int, default=0)
