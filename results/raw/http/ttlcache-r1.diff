+    def test_concurrent_same_key_computes_once(self):
+        """The production incident: many callers, one key -> fn runs once."""
+        c = TTLCache(60)
+        calls = []
+        calls_lock = threading.Lock()
+        start = threading.Barrier(40)
+
+        def loader():
+            with calls_lock:
+                calls.append(1)
+            time.sleep(0.1)  # hold the key open so every caller queues up
+            return "value"
+
+        results = [None] * 40
+
+        def call(i):
+            start.wait(timeout=5)
+            results[i] = c.get_or_compute("key", loader)
+
+        threads = [threading.Thread(target=call, args=(i,)) for i in range(40)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join(10)
+        self.assertTrue(all(not t.is_alive() for t in threads))
+        self.assertEqual(results, ["value"] * 40)
+        self.assertEqual(calls, [1])
+
+    def test_different_keys_do_not_block_each_other(self):
+        c = TTLCache(60)
+        started = threading.Barrier(2)
+        results = {}
+
+        def loader():
+            started.wait(timeout=5)   # both loaders must be inside at once
+            return "ok"
+
+        def run(key):
+            try:
+                results[key] = c.get_or_compute(key, loader)
+            except Exception as e:
+                results[key] = e
+
+        t1 = threading.Thread(target=run, args=("a",))
+        t2 = threading.Thread(target=run, args=("b",))
+        t1.start()
+        t2.start()
+        t1.join(10)
+        t2.join(10)
+        self.assertFalse(t1.is_alive())
+        self.assertFalse(t2.is_alive())
+        # If one key blocked the other, the barrier would time out.
+        self.assertEqual(results["a"], "ok")
+        self.assertEqual(results["b"], "ok")
+
+    def test_exception_propagates_to_all_waiters_and_not_cached(self):
+        c = TTLCache(60)
+        boom = RuntimeError("db down")
+        seen = [None] * 10
+        start = threading.Barrier(10)
+
+        def failing():
+            time.sleep(0.05)  # hold the key open so every caller queues up
+            raise boom
+
+        def call(i):
+            start.wait(timeout=5)
+            try:
+                c.get_or_compute("key", failing)
+                seen[i] = None
+            except RuntimeError as e:
+                seen[i] = e
+
+        threads = [threading.Thread(target=call, args=(i,)) for i in range(10)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join(10)
+        self.assertTrue(all(not t.is_alive() for t in threads))
+        self.assertTrue(all(e is boom for e in seen), seen)
+        self.assertEqual(len(c), 0)
+
+        # The next call retries instead of returning a cached failure.
+        self.assertEqual(c.get_or_compute("key", lambda: "recovered"), "recovered")
+        self.assertEqual(c.get_or_compute("key", lambda: "never"), "recovered")
+
+    def test_expiry_and_len_with_fake_clock(self):
+        now = [1000.0]
+        c = TTLCache(ttl=5, clock=lambda: now[0])
+        calls = []
+
+        def loader():
+            n = len(calls) + 1
+            calls.append(n)
+            return n
+
+        self.assertEqual(c.get_or_compute("a", loader), 1)
+        self.assertEqual(len(c), 1)
+
+        # Just before expiry: still a hit.
+        now[0] = 1004.9
+        self.assertEqual(c.get_or_compute("a", loader), 1)
+        self.assertEqual(len(c), 1)
+        self.assertEqual(calls, [1])
+
+        # Past expiry: recomputed.
+        now[0] = 1005.0 + 1e-9
+        self.assertEqual(c.get_or_compute("a", loader), 2)
+        self.assertEqual(len(c), 1)
+        self.assertEqual(calls, [1, 2])
+
+        # Expired entries are not counted.
+        now[0] = 1011.0
+        self.assertEqual(len(c), 0)
+        self.assertEqual(c.get_or_compute("a", loader), 3)
+        self.assertEqual(len(c), 1)
+
+    def test_expired_entry_recomputed_concurrently_once(self):
+        now = [0.0]
+        c = TTLCache(ttl=1, clock=lambda: now[0])
+        calls = []
+        calls_lock = threading.Lock()
+
+        def loader():
+            with calls_lock:
+                calls.append(1)
+            return "v"
+
+        t1 = threading.Thread(target=lambda: c.get_or_compute("a", loader))
+        t1.start()
+        t1.join(10)
+        self.assertEqual(calls, [1])
+
+        # Expire the entry, then two callers race on the recompute.
+        now[0] = 2.0
+        barrier = threading.Barrier(2)
+
+        def call():
+            barrier.wait(timeout=5)
+            self.assertEqual(c.get_or_compute("a", loader), "v")
+
+        t2 = threading.Thread(target=call)
+        t3 = threading.Thread(target=call)
+        t2.start()
+        t3.start()
+        t2.join(10)
+        t3.join(10)
+        self.assertEqual(len(calls), 2)
+
 
 if __name__ == "__main__":
     unittest.main()
