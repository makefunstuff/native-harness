+def parse_rows(rows, min_qty):
+    items = []
+    for i, r in enumerate(rows, start=1):
+        try:
+            qty = int(r["qty"])
+            price = float(r["price"])
+        except (TypeError, ValueError):
+            print(
+                f"skipping row {i}: unparseable qty/price ({r['qty']!r}, {r['price']!r})",
+                file=sys.stderr,
+            )
+            continue
+        if qty >= min_qty:
+            items.append({"name": r["name"], "qty": qty, "price": price})
+    items.sort(key=lambda d: d["name"])
+    return items
+
