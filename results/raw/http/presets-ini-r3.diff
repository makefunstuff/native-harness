+"""Reader for llama.cpp router preset files (INI-ish, hand-parsed)."""
+
+import sys
+
+
+def load_presets(path):
+    """Parse a preset file.
+
+    Returns a dict mapping preset name -> merged {key: value}, in file order.
+    Keys appearing before the first [section] line are global defaults
+    inherited by every section; a section's own key overrides the default.
+
+    Raises ValueError (mentioning the 1-based line number) on a duplicate
+    section name or a non-blank, non-comment line that is neither a section
+    header nor contains '='.
+    """
+    with open(path, "r", encoding="utf-8") as f:
+        lines = f.readlines()
+
+    defaults = {}
+    presets = {}
+    current = None  # dict for the active section, or None before the first header
+
+    for lineno, raw in enumerate(lines, 1):
+        stripped = raw.strip()
+        if not stripped or stripped[0] in ("#", ";"):
+            continue
+
+        if stripped.startswith("[") and stripped.endswith("]"):
+            name = stripped[1:-1]
+            if name in presets:
+                raise ValueError(f"duplicate section '{name}' at line {lineno}")
+            merged = dict(defaults)
+            presets[name] = merged
+            current = presets[name]
+            continue
+
+        if "=" not in stripped:
+            raise ValueError(f"expected 'key = value' or '[section]' at line {lineno}")
+
+        key, value = stripped.split("=", 1)
+        key = key.strip()
+        value = value.strip()
+
+        if current is None:
+            defaults[key] = value
+        else:
+            current[key] = value
+
+    return presets
+
+
+def _fmt(value):
+    return value if value else "-"
+
+
+def main(argv):
+    if len(argv) != 2:
+        print(f"usage: {argv[0]} FILE", file=sys.stderr)
+        return 2
+
+    try:
+        presets = load_presets(argv[1])
+    except (OSError, ValueError) as e:
+        print(f"error: {e}", file=sys.stderr)
+        return 1
+
+    for name, keys in presets.items():
+        ctx = _fmt(keys.get("ctx-size"))
+        device = _fmt(keys.get("device"))
+        split = keys.get("split-mode") or "layer"
+        draft = "yes" if "spec-draft-model" in keys else "no"
+        print(f"{name} ctx={ctx} devices={device} split={split} draft={draft}")
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
