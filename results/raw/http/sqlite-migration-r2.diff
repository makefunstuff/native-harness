 import sqlite3
+from datetime import date
+
+SCHEMA_VERSION = 2
+
+# SQL statements run (in order) to migrate from version N-1 to version N.
+# After a migration's statements run, schema_version is updated within the
+# same transaction, so a failed migration leaves the database at the
+# previous version.
+_MIGRATIONS = {
+    1: [
+        "CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+        "done INTEGER NOT NULL DEFAULT 0)",
+    ],
+    2: [
+        "ALTER TABLE tasks ADD COLUMN due_date TEXT",
+    ],
+}
+
+
+def _has_version_table(conn):
+    return conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'schema_version'"
+    ).fetchone() is not None
+
+
+def _detect_version(conn):
+    """Return the database schema version: 0 for an empty/new file."""
+    if _has_version_table(conn):
+        return conn.execute("SELECT version FROM schema_version").fetchone()[0]
+    # No schema_version table: a current-release database (has tasks) is
+    # version 1; anything else is treated as new.
+    has_tasks = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'tasks'"
+    ).fetchone()
+    return 1 if has_tasks else 0
+
+
+def _migrate(conn):
+    version = _detect_version(conn)
+    for target in range(version + 1, SCHEMA_VERSION + 1):
+        conn.execute("BEGIN")
+        try:
+            if not _has_version_table(conn):
+                conn.execute("CREATE TABLE schema_version (version INTEGER NOT NULL)")
+                conn.execute("INSERT INTO schema_version (version) VALUES (?)", (version,))
+            for statement in _MIGRATIONS[target]:
+                conn.execute(statement)
+            conn.execute("UPDATE schema_version SET version = ?", (target,))
+            conn.execute("COMMIT")
+        except BaseException:
+            conn.execute("ROLLBACK")
+            raise
 
 
