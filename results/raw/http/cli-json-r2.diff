+def parse_rows(rows, min_qty):
+    """Return parsed rows (dicts with name/qty/price) filtered by min_qty.
+
+    Rows whose qty or price cannot be parsed are skipped, with a warning
+    on stderr per skipped row.
+    """
+    good = []
+    for i, r in enumerate(rows, start=1):
+        try:
+            qty = int(r["qty"])
+            price = float(r["price"])
+        except (KeyError, TypeError, ValueError):
+            print(f"skipping row {i}: bad qty or price", file=sys.stderr)
+            continue
+        if qty < min_qty:
+            continue
+        good.append({"name": r["name"], "qty": qty, "price": price})
+    return good
+
+
 def main(argv=None):
