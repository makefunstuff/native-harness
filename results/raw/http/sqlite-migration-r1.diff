+        conn.commit()
+        conn.close()
+
+    def test_new_db_is_version_2(self):
+        d = tempfile.mkdtemp()
+        conn = todo.open_db(os.path.join(d, "t.db"))
+        self.assertEqual(conn.execute("SELECT version FROM schema_version").fetchone()[0], 2)
+        cols = {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}
+        self.assertIn("due_date", cols)
+
+    def test_legacy_db_migrates_in_place(self):
+        d = tempfile.mkdtemp()
+        path = os.path.join(d, "t.db")
+        self._legacy_db(path)
+        conn = todo.open_db(path)
+        self.assertEqual(conn.execute("SELECT version FROM schema_version").fetchone()[0], 2)
+        tasks = todo.list_tasks(conn)
+        self.assertEqual(len(tasks), 1)
+        self.assertEqual(tasks[0]["title"], "old task")
+        self.assertIsNone(tasks[0]["due_date"])
+
+    def test_opening_migrated_db_changes_nothing(self):
+        d = tempfile.mkdtemp()
+        path = os.path.join(d, "t.db")
+        todo.open_db(path).close()
+        todo.open_db(path).close()
+        # Reopen through todo: version stays 2, no duplicate rows in schema_version
+        conn = todo.open_db(path)
+        self.assertEqual(conn.execute("SELECT COUNT(*) FROM schema_version").fetchone()[0], 1)
+        self.assertEqual(conn.execute("SELECT version FROM schema_version").fetchone()[0], 2)
+
+    def test_migration_failure_leaves_previous_version(self):
+        d = tempfile.mkdtemp()
+        path = os.path.join(d, "t.db")
+        self._legacy_db(path)
+        # Simulate a failing v2 migration: make the column add impossible.
+        import todo as t
+        original = t.MIGRATIONS[2]
+        t.MIGRATIONS[2] = ["THIS IS NOT VALID SQL"]
+        try:
+            with self.assertRaises(sqlite3.Error):
+                t.open_db(path)
