+import re
 import sqlite3
+from datetime import date
+
+SCHEMA_VERSION = 2
+
+MIGRATIONS = {
+    1: [
+        "CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+        "done INTEGER NOT NULL DEFAULT 0)"
+    ],
+    2: [
+        "ALTER TABLE tasks ADD COLUMN due_date TEXT"
+    ],
+}
+
+_DUE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+
+
+def _validate_due_date(due_date):
+    if due_date is None:
+        return
+    if not isinstance(due_date, str) or not _DUE_RE.match(due_date):
+        raise ValueError(f"due_date must be a YYYY-MM-DD string, got {due_date!r}")
+    try:
+        date.fromisoformat(due_date)
+    except ValueError:
+        raise ValueError(f"due_date is not a valid date: {due_date!r}")
+
+
+def _has_table(conn, name):
+    return conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name = ?", (name,)
+    ).fetchone() is not None
+
+
+def _current_version_table_exists(conn):
+    return _has_table(conn, "schema_version")
+
+
+def _current_version(conn):
+    if not _has_table(conn, "schema_version"):
+        # No schema_version table: a legacy database with a tasks table counts
+        # as version 1; a fresh (empty) database counts as version 0.
+        return 1 if _has_table(conn, "tasks") else 0
+    return conn.execute("SELECT version FROM schema_version").fetchone()[0]
+
+
+def _apply_migrations(conn):
+    version = _current_version(conn)
+    has_version_table = _current_version_table_exists(conn)
+    for target in range(version + 1, SCHEMA_VERSION + 1):
+        conn.execute("BEGIN")
+        try:
+            if not has_version_table:
+                # Legacy databases skip migrations whose effects they already
+                # have, so create the bookkeeping table in the first migration
+                # that actually runs.
+                conn.execute("CREATE TABLE schema_version "
+                             "(id INTEGER PRIMARY KEY CHECK (id = 1), version INTEGER NOT NULL)")
+                has_version_table = True
+            for sql in MIGRATIONS[target]:
+                conn.execute(sql)
+            conn.execute(
+                "INSERT OR REPLACE INTO schema_version (id, version) VALUES (1, ?)", (target,)
+            )
+            conn.execute("COMMIT")
+        except Exception:
+            conn.execute("ROLLBACK")
+            raise
 
 
