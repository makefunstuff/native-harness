 import sqlite3
 
+# Schema versions:
+#   1 - tasks(id INTEGER PRIMARY KEY, title TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0)
+#   2 - adds due_date TEXT (ISO date, nullable)
+SCHEMA_VERSION = 2
+
+_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+
 
