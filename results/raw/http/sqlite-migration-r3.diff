+def _current_version(conn):
+    row = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'schema_version'"
+    ).fetchone()
+    if row is None:
+        # No schema_version table: a database that already has the tasks table
+        # is from the current release and counts as version 1.
+        tasks = conn.execute(
+            "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'tasks'"
+        ).fetchone()
+        return 1 if tasks is not None else 0
+    return conn.execute("SELECT version FROM schema_version LIMIT 1").fetchone()[0]
+
+
+def _migrate(conn):
+    """Bring the database at conn to SCHEMA_VERSION.
+
+    Each step runs in its own transaction, so a failure leaves the database
+    at the previous version.
+    """
+    version = _current_version(conn)
+    while version < SCHEMA_VERSION:
+        version += 1
+        conn.execute("BEGIN")
+        try:
+            if version == 1:
+                conn.execute(
+                    "CREATE TABLE schema_version (version INTEGER NOT NULL PRIMARY KEY)"
+                )
+                conn.execute(
+                    "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, "
+                    "title TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0)"
+                )
+            else:
+                # Legacy databases have no version table; start tracking it now.
+                conn.execute(
+                    "CREATE TABLE IF NOT EXISTS schema_version (version INTEGER NOT NULL PRIMARY KEY)"
+                )
+                conn.execute("INSERT OR IGNORE INTO schema_version (version) VALUES (1)")
+                for sql in _migrations_to(version):
+                    conn.execute(sql)
+            if version == 1:
+                conn.execute("INSERT INTO schema_version (version) VALUES (1)")
+            else:
+                conn.execute("UPDATE schema_version SET version = ?", (version,))
+            conn.execute("COMMIT")
+        except BaseException:
+            conn.execute("ROLLBACK")
+            raise
+
+
+def _migrations_to(version):
+    """SQL statements to upgrade a version-1 database to `version`."""
+    assert version == 2
+    return ["ALTER TABLE tasks ADD COLUMN due_date TEXT"]
+
+
+def _validate_due_date(due_date):
+    if due_date is None:
+        return
+    if not isinstance(due_date, str) or not _DATE_RE.match(due_date):
+        raise ValueError("due_date must be None or a YYYY-MM-DD string, got %r" % (due_date,))
+    try:
+        datetime.date.fromisoformat(due_date)
+    except ValueError:
+        raise ValueError("due_date %r is not a valid ISO date" % (due_date,)) from None
+
+
+def add_task(conn, title, due_date=None):
+    _validate_due_date(due_date)
+    cur = conn.execute(
+        "INSERT INTO tasks (title, due_date) VALUES (?, ?)", (title, due_date)
+    )
