+def parse_rows(path, min_qty):
+    """Load CSV rows, filtering by min_qty.
+
+    Returns a list of (name, qty, price) tuples. Rows with unparseable
+    qty/price are skipped with a warning on stderr.
+    """
+    rows = []
+    for i, r in enumerate(load(path), start=1):
+        try:
+            qty = int(r["qty"])
+            price = float(r["price"])
+        except (TypeError, ValueError):
+            print(f"skipping row {i}: cannot parse qty/price", file=sys.stderr)
+            continue
+        if qty < min_qty:
+            continue
+        rows.append((r["name"], qty, price))
+    return rows
+
+
 def main(argv=None):
     ap = argparse.ArgumentParser(description="Report stock levels")
     ap.add_argument("csv")
     ap.add_argument("--min-qty", type=int, default=0)
+    ap.add_argument("--format", choices=["table", "json"], default="table")
     a = ap.parse_args(argv)
-    rows = [r for r in load(a.csv) if int(r["qty"]) >= a.min_qty]
-    for r in sorted(rows, key=lambda r: r["name"]):
-        print(f"{r['name']:<20} {int(r['qty']):>6} {float(r['price']):>10.2f}")
+    rows = sorted(parse_rows(a.csv, a.min_qty), key=lambda r: r[0])
+    if a.format == "json":
+        print(json.dumps(
+            [{"name": n, "qty": q, "price": p} for n, q, p in rows],
+            indent=2))
+    else:
+        for n, q, p in rows:
+            print(f"{n:<20} {q:>6} {p:>10.2f}")
     return 0
 
 
