+    def test_single_flight_same_key(self):
+        c = TTLCache(60)
+        calls = []
+        barrier = threading.Barrier(20)
+        results = [None] * 20
+
+        def loader(i):
+            barrier.wait()
+            calls.append(i)
+            return i
+
+        def caller(i):
+            results[i] = c.get_or_compute("k", lambda: loader(i))
+
+        threads = [threading.Thread(target=caller, args=(i,)) for i in range(20)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(len(calls), 1)
+        self.assertTrue(all(r == results[0] for r in results))
+
+    def test_different_keys_parallel(self):
+        c = TTLCache(60)
+        state = {"running": 0, "max": 0}
+        mu = threading.Lock()
+        barrier = threading.Barrier(2)
+
+        def loader():
+            barrier.wait()
+            with mu:
+                state["running"] += 1
+                state["max"] = max(state["max"], state["running"])
+            barrier.wait()  # hold the slot while the other loader runs
+            with mu:
+                state["running"] -= 1
+            return 0
+
+        done = [None, None]
+
+        def caller(i):
+            done[i] = c.get_or_compute("k%d" % i, loader)
+
+        t1 = threading.Thread(target=caller, args=(0,))
+        t2 = threading.Thread(target=caller, args=(1,))
+        t1.start()
+        t2.start()
+        t1.join()
+        t2.join()
+        self.assertEqual(done, [0, 0])
+        self.assertEqual(state["max"], 2)
+
+    def test_exception_not_cached(self):
+        c = TTLCache(60)
+        boom = RuntimeError("db down")
+        with self.assertRaises(RuntimeError):
+            c.get_or_compute("a", lambda: (_ for _ in ()).throw(boom))
+        self.assertEqual(len(c), 0)
+        # Next call retries and succeeds.
+        self.assertEqual(c.get_or_compute("a", lambda: 42), 42)
+
+    def test_exception_shared_with_waiters(self):
+        c = TTLCache(60)
+        started = threading.Event()
+        release = threading.Event()
+
+        def loader():
+            started.set()
+            release.wait()
+            raise ValueError("nope")
+
+        errors = [None]
+        barrier = threading.Barrier(3)
+
+        def waiter():
+            barrier.wait()
+            try:
+                c.get_or_compute("a", loader)
+            except ValueError as e:
+                errors.append(e)
+
+        t1 = threading.Thread(target=waiter)
+        t2 = threading.Thread(target=waiter)
+        t1.start()
+        t2.start()
+        barrier.wait()  # all three (incl. main) lined up
+        with self.assertRaises(ValueError):
+            c.get_or_compute("a", loader)  # main thread is the one running fn
+        release.set()
+        t1.join()
+        t2.join()
+        self.assertEqual(len(errors), 2)
+
+    def test_expiry(self):
+        now = [1000.0]
+        clock = lambda: now[0]
+        c = TTLCache(60, clock=clock)
+        calls = 0
+
+        def loader():
+            nonlocal calls
+            calls += 1
+            return calls
+
+        self.assertEqual(c.get_or_compute("a", loader), 1)
+        now[0] = 1059.0
+        self.assertEqual(c.get_or_compute("a", loader), 1)
+        self.assertEqual(len(c), 1)
+        now[0] = 1060.0  # exactly ttl after storing -> expired
+        self.assertEqual(c.get_or_compute("a", loader), 2)
+        self.assertEqual(len(c), 1)
+
+    def test_len_ignores_expired(self):
+        now = [0.0]
+        c = TTLCache(10, clock=lambda: now[0])
+        c.get_or_compute("a", lambda: 1)
+        c.get_or_compute("b", lambda: 2)
+        self.assertEqual(len(c), 2)
+        now[0] = 11.0
+        self.assertEqual(len(c), 0)
+
 
