 import unittest
+import warnings
+
 from svc.config import load_config
+from svc.client import Client
+from svc.server import Server
 
 
 class ConfigTest(unittest.TestCase):
     def test_defaults(self):
         c = load_config({})
         self.assertEqual(c.port, 8080)
+        self.assertEqual(c.host, "127.0.0.1")
+        self.assertEqual(c.timeout_s, 30)
+
+    def test_timeout_s_key(self):
+        c = load_config({"timeout_s": 5.5})
+        self.assertEqual(c.timeout_s, 5.5)
+
+    def test_old_timeout_key_warns(self):
+        with self.assertWarns(DeprecationWarning):
+            c = load_config({"timeout": 7})
+        self.assertEqual(c.timeout_s, 7)
+
+    def test_both_keys_raise(self):
+        with self.assertRaises(ValueError):
+            load_config({"timeout": 1, "timeout_s": 2})
+
+    def test_invalid_timeout_s(self):
+        for bad in (0, -3, "10", None, True, [1]):
+            with self.assertRaises(ValueError, msg=repr(bad)):
+                load_config({"timeout_s": bad})
+
+    def test_timeout_alias_warns(self):
+        c = load_config({"timeout_s": 12})
+        with self.assertWarns(DeprecationWarning):
+            self.assertEqual(c.timeout, 12)
+
+    def test_timeout_alias_is_read_only(self):
+        c = load_config({"timeout_s": 12})
+        with self.assertRaises(AttributeError):
+            c.timeout = 1
+
+    def test_new_style_config_emits_no_warnings(self):
+        with warnings.catch_warnings():
+            warnings.simplefilter("error")
+            c = load_config({"timeout_s": 4})
+            self.assertEqual(Client(c).request_options()["timeout"], 4)
+            self.assertEqual(Server(c).keepalive_deadline(100), 108)
 
 
