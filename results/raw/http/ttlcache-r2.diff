+    def test_concurrent_same_key_computes_once(self):
+        import time
+
+        c = TTLCache(60)
+        calls = []
+        calls_lock = threading.Lock()
+        start = threading.Barrier(40)
+        results = []
+        results_lock = threading.Lock()
+
+        def loader():
+            with calls_lock:
+                calls.append(1)
+            time.sleep(0.05)  # keep the computation in flight for other callers
+            return 42
+
+        def worker():
+            r = c.get_or_compute("k", loader)
+            with results_lock:
+                results.append(r)
+
+        threads = [threading.Thread(target=lambda: (start.wait(), worker()))
+                   for _ in range(40)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(calls, [1])
+        self.assertEqual(results, [42] * 40)
+
+    def test_different_keys_do_not_block(self):
+        c = TTLCache(60)
+        order = []
+        lock = threading.Lock()
+        release_b = threading.Event()
+        b_done = threading.Event()
+
+        def slow_a():
+            with lock:
+                order.append("a-start")
+            release_b.wait(timeout=5)
+            with lock:
+                order.append("a-end")
+            return "A"
+
+        def slow_b():
+            with lock:
+                order.append("b-start")
+            result = "B"
+            with lock:
+                order.append("b-end")
+            b_done.set()
+            return result
+
+        a = threading.Thread(target=lambda: c.get_or_compute("a", slow_a))
+        b = threading.Thread(target=lambda: c.get_or_compute("b", slow_b))
+        b.start()
+        a.start()
+        # b must have finished while a is still blocked.
+        self.assertTrue(b_done.wait(timeout=5),
+                        f"b finished before a even started: {order}")
+        release_b.set()
+        a.join()
+        b.join()
+        # b completed while a was still blocked on release_b.
+        self.assertIn("b-end", order[:order.index("a-end")])
+        self.assertEqual(order[-1], "a-end")
+
+    def test_exception_propagates_to_all_waiters_and_not_cached(self):
+        class Boom(Exception):
+            pass
+
+        c = TTLCache(60)
+        boom = Boom("db down")
+        calls = []
+        start = threading.Barrier(4)
+        errors = []
+        errors_lock = threading.Lock()
+
+        def loader():
+            calls.append(1)
+            import time
+            time.sleep(0.05)
+            raise boom
+
+        def worker():
+            try:
+                c.get_or_compute("k", loader)
+            except Boom as e:
+                with errors_lock:
+                    errors.append(e)
+
+        threads = [threading.Thread(target=lambda: (start.wait(), worker()))
+                   for _ in range(4)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(calls, [1])
+        self.assertIs(errors[0], boom)
+        self.assertIs(errors[-1], boom)
+        # Nothing was cached; the next call retries.
+        self.assertEqual(len(c), 0)
+        calls.clear()
+        self.assertIsNone(c.get_or_compute("k", lambda: calls.append(1) or None))
+        self.assertEqual(calls, [1])
+
+    def test_expiry_with_fake_clock(self):
+        now = [0.0]
+        c = TTLCache(10, clock=lambda: now[0])
+        calls = []
+
+        def loader():
+            calls.append(1)
+            return len(calls)
+
+        self.assertEqual(c.get_or_compute("k", loader), 1)
+        self.assertEqual(len(c), 1)
+        # Within the TTL: served from cache.
+        now[0] = 9.9
+        self.assertEqual(c.get_or_compute("k", loader), 1)
+        # Expired: recomputed.
+        now[0] = 10.0
+        self.assertEqual(c.get_or_compute("k", loader), 2)
+        # Expired entries are not counted.
+        now[0] = 20.0
+        self.assertEqual(len(c), 0)
+        self.assertEqual(c.get_or_compute("k", loader), 3)
+
+    def test_len_counts_only_live_entries(self):
+        now = [0.0]
+        c = TTLCache(10, clock=lambda: now[0])
+        c.get_or_compute("a", lambda: 1)
+        c.get_or_compute("b", lambda: 2)
+        c.get_or_compute("c", lambda: 3)
+        self.assertEqual(len(c), 3)
+        now[0] = 10.0
+        self.assertEqual(len(c), 0)
+
 
 if __name__ == "__main__":
     unittest.main()
