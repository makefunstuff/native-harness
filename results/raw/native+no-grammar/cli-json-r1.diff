+def parse_rows(rows, min_qty):
+    """Return [(name, qty, price)] for parseable rows with qty >= min_qty,
+    skipping bad rows with a warning on stderr (1-based data row number)."""
+    out = []
+    for i, r in enumerate(rows, 1):
+        try:
+            qty = int(r["qty"])
+            price = float(r["price"])
+        except (ValueError, TypeError):
+            print(f"skipping row {i}: bad qty or price", file=sys.stderr)
+            continue
+        if qty >= min_qty:
+            out.append((r["name"], qty, price))
+    return out
+
+
 def main(argv=None):
