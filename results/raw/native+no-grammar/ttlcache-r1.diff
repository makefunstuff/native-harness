+    def test_single_flight_same_key(self):
+        calls = []
+        gate = threading.Event()
+        c = TTLCache(60)
+
+        def loader():
+            calls.append(1)
+            gate.wait(5)
+            return 42
+
+        results = []
+        threads = [threading.Thread(target=lambda: results.append(c.get_or_compute("k", loader)))
+                   for _ in range(40)]
+        for t in threads:
+            t.start()
+        gate.wait(0.2)  # let all threads pile up on the loader
+        gate.set()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(results, [42] * 40)
+        self.assertEqual(c.get_or_compute("k", lambda: "other"), 42)
+
+    def test_different_keys_do_not_block(self):
+        order = []
+        gate_a = threading.Event()
+        c = TTLCache(60)
+
+        def loader_a():
+            order.append(("start", "a"))
+            gate_a.wait(5)
+            order.append(("end", "a"))
+            return "a"
+
+        def loader_b():
+            order.append(("start", "b"))
+            order.append(("end", "b"))
+            return "b"
+
+        ta = threading.Thread(target=lambda: c.get_or_compute("a", loader_a))
+        ta.start()
+        # Block key "a" mid-computation; key "b" must still complete.
+        threading.Event().wait(0.2)
+        self.assertIn(("start", "a"), order)
+        tb = threading.Thread(target=lambda: c.get_or_compute("b", loader_b))
+        tb.start()
+        tb.join(5)  # would hang if "b" were blocked behind "a"
+        self.assertFalse(tb.is_alive())
+        self.assertIn(("end", "b"), order)
+        self.assertNotIn(("end", "a"), order)  # "a" still blocked on its gate
+        gate_a.set()
+        ta.join()
+
+    def test_error_propagates_to_all_and_not_cached(self):
+        gate = threading.Event()
+        c = TTLCache(60)
+        attempts = []
+
+        def boom():
+            attempts.append(1)
+            gate.wait(5)
+            raise ValueError("boom")
+
+        results = []
+
+        def runner():
+            try:
+                results.append(c.get_or_compute("k", boom))
+            except ValueError as e:
+                results.append(e)
+
+        threads = [threading.Thread(target=runner) for _ in range(5)]
+        for t in threads:
+            t.start()
+        gate.wait(0.2)
+        gate.set()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(len(attempts), 1)
+        self.assertEqual(len(results), 5)
+        self.assertTrue(all(isinstance(r, ValueError) and str(r) == "boom" for r in results))
+        # Nothing cached: next call tries again (and this time succeeds).
+        self.assertEqual(c.get_or_compute("k", lambda: "recovered"), "recovered")
+
+    def test_expiry_uses_injected_clock(self):
+        now = [1000.0]
+        c = TTLCache(10, clock=lambda: now[0])
+        calls = []
+        self.assertEqual(c.get_or_compute("k", lambda: calls.append(1) or 1), 1)
+        now[0] = 1009.999
+        self.assertEqual(c.get_or_compute("k", lambda: calls.append(1) or 2), 1)
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(len(c), 1)
+        now[0] = 1010.001  # strictly after expiry -> recomputed
+        self.assertEqual(c.get_or_compute("k", lambda: calls.append(1) or 2), 2)
+        self.assertEqual(len(calls), 2)
+        self.assertEqual(len(c), 1)
+
+    def test_len_counts_only_non_expired(self):
+        now = [0.0]
+        c = TTLCache(5, clock=lambda: now[0])
+        c.get_or_compute("a", lambda: 1)
+        c.get_or_compute("b", lambda: 2)
+        self.assertEqual(len(c), 2)
+        now[0] = 5.001
+        self.assertEqual(len(c), 0)
+
 
 if __name__ == "__main__":
     unittest.main()
