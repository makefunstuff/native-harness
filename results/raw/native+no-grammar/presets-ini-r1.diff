+"""Reader for llama.cpp router preset files (e.g. sample.ini).
+
+Hand-rolled parser: stdlib only, no configparser.
+"""
+
+import re
+import sys
+
+_SECTION_RE = re.compile(r"^\[(?P<name>[^\[\]]+)\]$")
+
+
+def _parse(text, source="<presets>"):
+    presets = {}
+    defaults = {}
+    current = None  # dict receiving keys, or None for global defaults
+
+    for lineno, raw in enumerate(text.splitlines(), start=1):
+        line = raw.strip()
+        if not line or line[0] in "#;":
+            continue
+
+        m = _SECTION_RE.match(line)
+        if m:
+            name = m.group("name").strip()
+            if name in presets:
+                raise ValueError(
+                    f"{source}:{lineno}: duplicate section [{name}]"
+                )
+            presets[name] = dict(defaults)
+            current = presets[name]
+            continue
+
+        if "=" in line:
+            key, _, value = line.partition("=")
+            if current is None:
+                defaults[key.strip()] = value.strip()
+            else:
+                current[key.strip()] = value.strip()
+            continue
+
+        raise ValueError(f"{source}:{lineno}: malformed line: {line!r}")
+
+    return presets
+
+
+def load_presets(path):
+    """Load a preset file; return preset name -> merged keys, in file order."""
+    with open(path, "r", encoding="utf-8") as f:
+        text = f.read()
+    return _parse(text, source=path)
+
+
+def main(argv):
+    if len(argv) != 2:
+        print(f"usage: {argv[0]} FILE", file=sys.stderr)
+        return 2
+    try:
+        presets = load_presets(argv[1])
+    except (OSError, ValueError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+
+    for name, kv in presets.items():
+        print(
+            f"{name} "
+            f"ctx={kv.get('ctx-size', '-')} "
+            f"devices={kv.get('device', '-')} "
+            f"split={kv.get('split-mode', 'layer')} "
+            f"draft={'yes' if 'spec-draft-model' in kv else 'no'}"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
