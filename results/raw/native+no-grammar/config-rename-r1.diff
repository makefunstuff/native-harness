 import unittest
+import warnings
+from svc.client import Client
 from svc.config import load_config
+from svc.server import Server
 
 
 class ConfigTest(unittest.TestCase):
     def test_defaults(self):
         c = load_config({})
         self.assertEqual(c.port, 8080)
+        self.assertEqual(c.host, "127.0.0.1")
+        self.assertEqual(c.timeout_s, 30)
+
+    def test_new_key(self):
+        c = load_config({"timeout_s": 5})
+        self.assertEqual(c.timeout_s, 5)
+        self.assertEqual(load_config({"timeout_s": 2.5}).timeout_s, 2.5)
+
+    def test_old_key_warns_and_is_used(self):
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            c = load_config({"timeout": 10})
+        self.assertEqual(c.timeout_s, 10)
+        self.assertEqual(len(w), 1)
+        self.assertIs(w[0].category, DeprecationWarning)
+
+    def test_timeout_alias_warns_and_is_read_only(self):
+        c = load_config({})
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            self.assertEqual(c.timeout, 30)
+        self.assertEqual(len(w), 1)
+        self.assertIs(w[0].category, DeprecationWarning)
+        with self.assertRaises(AttributeError):
+            c.timeout = 5
+
+    def test_both_keys_raise(self):
+        with self.assertRaises(ValueError):
+            load_config({"timeout": 1, "timeout_s": 2})
+
+    def test_invalid_timeout_s_raises(self):
+        for bad in (0, -1, 0.0, -0.5, "30", None, [30]):
+            with self.assertRaises(ValueError):
+                load_config({"timeout_s": bad})
+
+    def test_client_and_server_use_timeout_s_silently(self):
+        c = load_config({"timeout_s": 7})
+        with warnings.catch_warnings():
+            warnings.simplefilter("error")
+            self.assertEqual(Client(c).request_options()["timeout"], 7)
+            self.assertEqual(Server(c).keepalive_deadline(100), 114)
 
 
