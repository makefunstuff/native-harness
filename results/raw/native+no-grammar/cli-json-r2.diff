+def read_rows(path, min_qty):
+    rows = []
+    for n, r in enumerate(load(path), start=1):
+        try:
+            qty = int(r["qty"])
+            price = float(r["price"])
+        except (KeyError, TypeError, ValueError):
+            print(
+                f"skipping row {n}: cannot parse qty or price "
+                f"(qty={r.get('qty')!r}, price={r.get('price')!r})",
+                file=sys.stderr,
+            )
+            continue
+        if qty >= min_qty:
+            rows.append({"name": r["name"], "qty": qty, "price": price})
+    return rows
+
+
