+    def test_different_keys_are_independent(self):
+        c = TTLCache(60)
+        self.assertEqual(c.get_or_compute("a", lambda: 1), 1)
+        self.assertEqual(c.get_or_compute("b", lambda: 2), 2)
+        self.assertEqual(len(c), 2)
+
+    def test_concurrent_same_key_computes_once(self):
+        c = TTLCache(60)
+        calls = []
+        lock = threading.Lock()
+        barrier = threading.Barrier(40)
+        results, errors = [], []
+
+        def load():
+            with lock:
+                calls.append(1)
+            return "v"
+
+        def worker():
+            barrier.wait()
+            try:
+                results.append(c.get_or_compute("k", load))
+            except Exception as e:  # pragma: no cover
+                errors.append(e)
+
+        threads = [threading.Thread(target=worker) for _ in range(40)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(results, ["v"] * 40)
+        self.assertEqual(errors, [])
+
+    def test_different_keys_run_in_parallel(self):
+        c = TTLCache(60)
+        gate = threading.Barrier(3)
+
+        def slow_load(i):
+            import time
+            time.sleep(0.3)
+            return i
+
+        import time
+        start = time.monotonic()
+        threads = [
+            threading.Thread(target=lambda i=i: c.get_or_compute(i, lambda: slow_load(i)))
+            for i in range(3)
+        ]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+        self.assertLess(time.monotonic() - start, 0.9)
+
+    def test_error_not_cached_and_shared_with_waiters(self):
+        c = TTLCache(60)
+        boomed = []
+        lock = threading.Lock()
+        barrier = threading.Barrier(5)
+        exceptions = []
+
+        class Boom(Exception):
+            pass
+
+        def fail():
+            with lock:
+                boomed.append(1)
+            import time
+            time.sleep(0.02)
+            raise Boom("db down")
+
+        def worker():
+            barrier.wait()
+            try:
+                c.get_or_compute("x", fail)
+            except Boom as e:
+                exceptions.append(e)
+
+        threads = [threading.Thread(target=worker) for _ in range(5)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(len(boomed), 1)
+        self.assertEqual(len(exceptions), 5)
+        self.assertTrue(all(e is exceptions[0] for e in exceptions))
+        self.assertEqual(len(c), 0)
+        # nothing was cached: the next call retries
+        self.assertEqual(c.get_or_compute("x", lambda: "recovered"), "recovered")
+
+    def test_expiry_uses_injected_clock(self):
+        now = [0.0]
+        c = TTLCache(10, clock=lambda: now[0])
+        calls = []
+        self.assertEqual(
+            c.get_or_compute("a", lambda: calls.append(1) or 1), 1
+        )
+        now[0] = 9.9
+        self.assertEqual(
+            c.get_or_compute("a", lambda: calls.append(1) or 2), 1
+        )
+        now[0] = 10.1
+        self.assertEqual(
+            c.get_or_compute("a", lambda: calls.append(1) or 3), 3
+        )
+        self.assertEqual(len(calls), 2)
+
+    def test_len_counts_only_non_expired_entries(self):
+        now = [0.0]
+        c = TTLCache(10, clock=lambda: now[0])
+        c.get_or_compute("a", lambda: 1)
+        c.get_or_compute("b", lambda: 2)
+        self.assertEqual(len(c), 2)
+        now[0] = 11.0
+        self.assertEqual(len(c), 0)
+        # expired entries are recomputed
+        self.assertEqual(c.get_or_compute("a", lambda: 3), 3)
+        self.assertEqual(len(c), 1)
+
 
