+        old.execute("CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+                    "done INTEGER NOT NULL DEFAULT 0)")
+        old.executemany("INSERT INTO tasks (title, done) VALUES (?, ?)",
