+import re
 import sqlite3
+from datetime import date
+
+# Each entry migrates from version N to N+1, where N is the 1-based index.
+MIGRATIONS = [
+    # 0 -> 1: the original release schema
+    ["CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+     "done INTEGER NOT NULL DEFAULT 0)"],
+    # 1 -> 2: add due_date (ISO date, nullable)
+    ["ALTER TABLE tasks ADD COLUMN due_date TEXT"],
+]
+
+SCHEMA_VERSION = len(MIGRATIONS)  # 2
+
+_DUE_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+
+
+def _current_version(conn):
+    """Version of the database: 0 (empty), 1 (has tasks but no schema_version), or stored value."""
+    has_schema_version = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name='schema_version'"
+    ).fetchone()
+    if has_schema_version:
+        return conn.execute("SELECT version FROM schema_version").fetchone()[0]
+    has_tasks = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name='tasks'"
+    ).fetchone()
+    return 1 if has_tasks else 0
 
 
