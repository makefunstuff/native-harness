+        b = todo.add_task(conn, "late two", due_date="2024-01-02")
+        c = todo.add_task(conn, "due today", due_date="2024-01-03")
+        e = todo.add_task(conn, "future", due_date="2024-02-01")
+        f = todo.add_task(conn, "no date")
