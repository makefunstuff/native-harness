+def parse_rows(rows, min_qty):
+    """Return sorted dicts {name, qty, price}; skip unparseable rows with a warning."""
+    items = []
+    for n, r in enumerate(rows, start=1):
+        try:
+            qty = int(r["qty"])
+            price = float(r["price"])
+        except (KeyError, ValueError):
+            print(f"skipping row {n}: unparseable qty or price", file=sys.stderr)
+            continue
+        if qty < min_qty:
+            continue
+        items.append({"name": r["name"], "qty": qty, "price": price})
+    return sorted(items, key=lambda it: it["name"])
+
+
