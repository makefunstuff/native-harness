+import re
 import sqlite3
+from datetime import datetime
+
+SCHEMA_VERSION = 2
+
+_DATE_RE = re.compile(r"\d{4}-\d{2}-\d{2}")
+
+
+def _valid_date(value):
+    if not isinstance(value, str) or not _DATE_RE.fullmatch(value):
+        return False
+    try:
+        datetime.strptime(value, "%Y-%m-%d")
+    except ValueError:
+        return False
+    return True
+
+
+def _migrations_for(version):
+    if version == 1:
+        # IF NOT EXISTS so this also runs on legacy databases that already
+        # have the tasks table.
+        return [
+            "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, "
+            "title TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0)",
+            "CREATE TABLE schema_version (version INTEGER NOT NULL)",
+            "INSERT INTO schema_version (version) VALUES (1)",
+        ]
+    if version == 2:
+        return [
+            "ALTER TABLE tasks ADD COLUMN due_date TEXT",
+            "UPDATE schema_version SET version = 2",
+        ]
+    raise RuntimeError("unknown migration target: %d" % version)
+
+
+def _current_version(conn):
+    has_schema_version = conn.execute(
+        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'schema_version'"
+    ).fetchone()
+    if has_schema_version:
+        return conn.execute("SELECT version FROM schema_version").fetchone()[0]
+    # No schema_version table: either a brand-new file or a database from the
+    # current release (tasks table, no schema_version table). Both start at
+    # version 0 and run migration 1, which is a no-op for the tasks table if
+    # it already exists.
+    return 0
+
+
+def _migrate(conn):
+    conn.isolation_level = None  # explicit transaction control
+    version = _current_version(conn)
+    while version < SCHEMA_VERSION:
+        version += 1
+        conn.execute("BEGIN")
+        try:
+            for statement in _migrations_for(version):
+                conn.execute(statement)
+            conn.execute("COMMIT")
+        except BaseException:
+            conn.execute("ROLLBACK")
+            raise
 
 
