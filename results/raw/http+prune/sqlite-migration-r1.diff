+def make_v1_db(path):
+    """Simulate a database from the current release: tasks table, no schema_version."""
+    conn = sqlite3.connect(path)
+    conn.execute("CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+                 "done INTEGER NOT NULL DEFAULT 0)")
+    conn.execute("INSERT INTO tasks (title, done) VALUES ('old task', 0)")
+    conn.execute("INSERT INTO tasks (title, done) VALUES ('old done', 1)")
+    conn.commit()
+    conn.close()
+
+
+def schema_version(path):
+    conn = sqlite3.connect(path)
+    try:
+        row = conn.execute("SELECT version FROM schema_version").fetchone()
+    except sqlite3.OperationalError:  # table does not exist
+        return None
+    finally:
+        conn.close()
+    return row[0] if row else None
+
+
