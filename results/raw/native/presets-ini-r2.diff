+"""Reader for llama.cpp router preset files (a hand-rolled INI subset).
+
+Deliberately not configparser: keys may contain characters configparser
+mangles, values may contain ``=``, and duplicate handling is explicit.
+
+File format:
+  - ``key = value`` lines; surrounding whitespace is stripped; the value may
+    itself contain ``=`` (split on the first ``=`` only).
+  - Lines whose first non-space character is ``#`` or ``;`` are comments;
+    blank lines are ignored.
+  - Keys before the first ``[section]`` are global defaults, inherited by
+    every section; a section's own key overrides the default.
+  - A duplicate section name, or a non-blank, non-comment line that is
+    neither a section header nor contains ``=``, raises ``ValueError``
+    mentioning the 1-based line number.
+"""
+
+from __future__ import annotations
+
+import sys
+from typing import Dict
+
+
+def _parse(text: str) -> Dict[str, Dict[str, str]]:
+    defaults: Dict[str, str] = {}
+    presets: Dict[str, Dict[str, str]] = {}
+    current: Dict[str, str] | None = None
+
+    for lineno, raw in enumerate(text.splitlines(), 1):
+        line = raw.strip()
+        if not line:
+            continue
+        if line[0] in "#;":
+            continue
+
+        if len(line) > 1 and line[0] == "[" and line[-1] == "]":
+            name = line[1:-1].strip()
+            if name in presets:
+                raise ValueError(
+                    f"line {lineno}: duplicate section [{name}]"
+                )
+            merged = dict(defaults)
+            presets[name] = merged
+            current = merged
+            continue
+
+        if "=" in line:
+            key, value = line.split("=", 1)
+            key = key.strip()
+            value = value.strip()
+            if current is None:
+                defaults[key] = value
+            else:
+                current[key] = value
+            continue
+
+        raise ValueError(
+            f"line {lineno}: not a section header or key = value pair: {line!r}"
+        )
+
+    return presets
+
+
+def load_presets(path: str) -> Dict[str, Dict[str, str]]:
+    """Parse ``path`` and return preset name -> merged keys, in file order."""
+    with open(path, "r", encoding="utf-8") as f:
+        return _parse(f.read())
+
+
+def _report_line(name: str, keys: Dict[str, str]) -> str:
+    ctx = keys.get("ctx-size", "-")
+    devices = keys.get("device", "-")
+    split = keys.get("split-mode", "layer")
+    draft = "yes" if "spec-draft-model" in keys else "no"
+    return f"{name} ctx={ctx} devices={devices} split={split} draft={draft}"
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) < 2:
+        print(f"usage: {argv[0] if argv else 'presets.py'} FILE", file=sys.stderr)
+        return 2
+    presets = load_presets(argv[1])
+    for name, keys in presets.items():
+        print(_report_line(name, keys))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
