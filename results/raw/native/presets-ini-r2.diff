+import os
+import tempfile
+import unittest
+
+import presets
+
+
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class ParserTest(unittest.TestCase):
+    def parse(self, text):
+        with tempfile.NamedTemporaryFile(
+            "w", suffix=".ini", delete=False
+        ) as f:
+            f.write(text)
+            path = f.name
+        try:
+            return presets.load_presets(path)
+        finally:
+            os.unlink(path)
+
+    def test_value_contains_equals(self):
+        p = self.parse("[a]\nurl = http://x/?a=1&b=2\n")
+        self.assertEqual(p["a"]["url"], "http://x/?a=1&b=2")
+
+    def test_key_with_underscore_and_dots(self):
+        p = self.parse("[a]\nspec-draft-model = d.gguf\nctx-size = 4096\n")
+        self.assertEqual(p["a"]["spec-draft-model"], "d.gguf")
+        self.assertEqual(p["a"]["ctx-size"], "4096")
+
+    def test_global_defaults_inherited_and_overridden(self):
+        p = self.parse(
+            "temp = 1.0\n[a]\nctx-size = 1\n[b]\ntemp = 0.0\n"
+        )
+        self.assertEqual(p["a"]["temp"], "1.0")
+        self.assertEqual(p["b"]["temp"], "0.0")
+        self.assertNotIn("ctx-size", p["b"])
+
+    def test_duplicate_section_raises_with_line_number(self):
+        with self.assertRaises(ValueError) as cm:
+            self.parse("[a]\n[a]\n")
+        self.assertIn("2", str(cm.exception))
+
+    def test_malformed_line_raises_with_line_number(self):
+        with self.assertRaises(ValueError) as cm:
+            self.parse("[a]\ngarbage line\n")
+        self.assertIn("2", str(cm.exception))
+
+    def test_empty_value(self):
+        p = self.parse("[a]\nkey =\n")
+        self.assertEqual(p["a"]["key"], "")
+
+    def test_no_sections(self):
+        self.assertEqual(self.parse("temp = 1.0\n"), {})
+
+
+class MainTest(unittest.TestCase):
+    def test_sample_report(self):
+        import io
+        import contextlib
+
+        buf = io.StringIO()
+        with contextlib.redirect_stdout(buf):
+            rc = presets.main(["presets.py", os.path.join(HERE, "sample.ini")])
+        self.assertEqual(rc, 0)
+        self.assertEqual(
+            buf.getvalue().splitlines(),
+            [
+                "qwen3.8-27b ctx=131072 devices=CUDA0,CUDA1 split=tensor draft=yes",
+                "zeta-2.1-q4 ctx=16384 devices=CUDA0 split=layer draft=no",
+            ],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
