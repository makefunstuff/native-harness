+import re
 import sqlite3
+from datetime import date
+
+SCHEMA_VERSION = 2
+_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+
+# Migration i (0-based index) takes a database from version i to version i+1.
+# Each entry is a list of SQL statements run in a single transaction.
+_MIGRATIONS = [
+    # version 0 -> 1: the schema of the original release
+    ["CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+     "done INTEGER NOT NULL DEFAULT 0)"],
+    # version 1 -> 2: add the due date column
+    ["ALTER TABLE tasks ADD COLUMN due_date TEXT"],
+]
+
+
+def _current_version(conn):
+    """Detect the schema version of an existing database."""
+    tables = {r[0] for r in conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table'")}
+    if "schema_version" in tables:
+        row = conn.execute("SELECT version FROM schema_version").fetchone()
+        return row[0] if row else 0
+    # A database from the current release has a tasks table but no
+    # schema_version table: it is version 1.
+    if "tasks" in tables:
+        return 1
+    return 0
+
+
+def _apply_migration(conn, to_version):
+    """Run the migration from to_version-1 to to_version, atomically."""
+    statements = _MIGRATIONS[to_version - 1]
+    # Explicit transaction (connection is in autocommit mode), so a failure
+    # rolls back and leaves the database at the previous version.
+    conn.execute("BEGIN")
+    try:
+        conn.execute("CREATE TABLE IF NOT EXISTS schema_version "
+                     "(version INTEGER NOT NULL)")
+        for sql in statements:
+            conn.execute(sql)
+        conn.execute("DELETE FROM schema_version")
+        conn.execute("INSERT INTO schema_version (version) VALUES (?)",
+                      (to_version,))
+        conn.execute("COMMIT")
+    except Exception:
+        conn.execute("ROLLBACK")
+        raise
 
 
