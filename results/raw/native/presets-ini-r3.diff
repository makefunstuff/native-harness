+"""Reader for llama.cpp router preset files, plus a small report CLI.
+
+Standard library only; the parser is hand-rolled (configparser mangles
+duplicate keys/sections and some of our keys).
+"""
+
+import sys
+
+
+def _parse(text):
+    """Parse preset file text into (globals, ordered sections).
+
+    Returns (defaults: dict, sections: dict[str, dict]) in file order.
+    """
+    defaults = {}
+    sections = {}
+    current = None  # None while in the global scope
+
+    for lineno, raw in enumerate(text.splitlines(), 1):
+        line = raw.strip()
+        if not line or line[0] in "#;":
+            continue
+
+        if line.startswith("[") and line.endswith("]"):
+            name = line[1:-1].strip()
+            if name in sections:
+                raise ValueError(f"duplicate section [{name!r}] at line {lineno}")
+            sections[name] = {}
+            current = sections[name]
+            continue
+
+        if "=" in line:
+            key, value = line.split("=", 1)
+            key = key.strip()
+            value = value.strip()
+            if current is None:
+                defaults[key] = value
+            else:
+                current[key] = value
+            continue
+
+        raise ValueError(f"unparseable line at line {lineno}: {line!r}")
+
+    return defaults, sections
+
+
+def load_presets(path):
+    """Read a preset file, returning {preset name: merged key->value} in file order."""
+    with open(path, "r", encoding="utf-8") as f:
+        defaults, sections = _parse(f.read())
+
+    merged = {}
+    for name, keys in sections.items():
+        preset = dict(defaults)
+        preset.update(keys)
+        merged[name] = preset
+    return merged
+
+
+def main(argv):
+    """CLI: python3 presets.py FILE — print one summary line per preset."""
+    if len(argv) != 2:
+        print(f"usage: {argv[0]} FILE", file=sys.stderr)
+        return 2
+    presets = load_presets(argv[1])
+    for name, p in presets.items():
+        ctx = p.get("ctx-size", "-")
+        device = p.get("device", "-")
+        split = p.get("split-mode", "layer")
+        draft = "yes" if "spec-draft-model" in p else "no"
+        print(f"{name} ctx={ctx} devices={device} split={split} draft={draft}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
