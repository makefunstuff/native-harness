+import re
 import sqlite3
+from datetime import date
+
+# Migrations are keyed by the version they *create*. Each entry is a list of
+# SQL statements run, together with the schema_version update, in one
+# transaction so a failure leaves the database at the previous version.
+MIGRATIONS = {
+    1: [
+        "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+        "done INTEGER NOT NULL DEFAULT 0)",
+    ],
+    2: [
+        "ALTER TABLE tasks ADD COLUMN due_date TEXT",
+    ],
+}
+
+SCHEMA_VERSION = 2
+
+
+def _detect_version(conn):
+    """Return the schema version of a database that may lack schema_version."""
+    row = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'schema_version'"
+    ).fetchone()
+    if row is not None:
+        return conn.execute("SELECT version FROM schema_version").fetchone()[0]
+    row = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'tasks'"
+    ).fetchone()
+    if row is None:
+        return 0
+    # A database with tasks but no schema_version table is a pre-migration
+    # release; it is version 1 unless due_date is already present.
+    cols = {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}
+    return 2 if "due_date" in cols else 1
+
+
+def _run_migrations(conn):
+    version = _detect_version(conn)
+    for target in range(version + 1, SCHEMA_VERSION + 1):
+        conn.execute("BEGIN IMMEDIATE")
+        try:
+            for stmt in MIGRATIONS[target]:
+                conn.execute(stmt)
+            conn.execute("CREATE TABLE IF NOT EXISTS schema_version (version INTEGER NOT NULL)")
+            conn.execute("DELETE FROM schema_version")
+            conn.execute("INSERT INTO schema_version (version) VALUES (?)", (target,))
+            conn.execute("COMMIT")
+        except Exception:
+            conn.execute("ROLLBACK")
+            raise
 
 
