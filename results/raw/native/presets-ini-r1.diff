+"""Reader for llama.cpp router preset files, plus a small report CLI.
+
+The file format is a subset of INI:
+
+- ``key = value`` lines; whitespace around key and value is stripped, and the
+  value may itself contain ``=`` (split on the first ``=`` only).
+- Lines whose first non-space character is ``#`` or ``;`` are comments; blank
+  lines are ignored.
+- Keys before the first ``[section]`` are global defaults inherited by every
+  section; a section's own key overrides the default.
+- A duplicate section name, or a non-blank, non-comment line that is neither
+  a section header nor contains ``=``, raises ``ValueError`` mentioning the
+  1-based line number.
+
+configparser is intentionally not used: it lowercases keys and mis-handles
+duplicate keys.
+"""
+
+import sys
+
+
+def load_presets(path):
+    """Parse *path* and return ``{preset name: {key: value, ...}}`` in file order.
+
+    Every section's mapping already includes the inherited global defaults
+    (with the section's own keys overriding them); all values are strings.
+    """
+    presets = {}          # name -> merged keys, in file order
+    defaults = {}         # keys seen before the first section
+    current = None        # [name, merged_keys] of the section being filled
+    with open(path, "r", encoding="utf-8") as fh:
+        for lineno, raw in enumerate(fh, 1):
+            line = raw.strip()
+            if not line or line[0] in "#;":
+                continue
+            if line[0] == "[" and line.endswith("]"):
+                name = line[1:-1].strip()
+                if not name:
+                    raise ValueError(f"line {lineno}: empty section header")
+                if name in presets:
+                    raise ValueError(f"line {lineno}: duplicate section [{name}]")
+                keys = dict(defaults)
+                current = [name, keys]
+                presets[name] = keys
+                continue
+            if "=" not in line:
+                raise ValueError(
+                    f"line {lineno}: expected '[section]' or 'key = value', got {line!r}"
+                )
+            key, value = line.split("=", 1)
+            key, value = key.strip(), value.strip()
+            if current is None:
+                defaults[key] = value
+            else:
+                current[1][key] = value
+    return presets
+
+
+def main(argv):
+    """``presets.py FILE``: print one report line per preset."""
+    if len(argv) != 1:
+        print("usage: python3 presets.py FILE", file=sys.stderr)
+        return 2
+    for name, keys in load_presets(argv[0]).items():
+        print(
+            f"{name} "
+            f"ctx={keys.get('ctx-size', '-')} "
+            f"devices={keys.get('device', '-')} "
+            f"split={keys.get('split-mode', 'layer')} "
+            f"draft={'yes' if 'spec-draft-model' in keys else 'no'}"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
