+class ConcurrentTest(unittest.TestCase):
+    def test_same_key_computed_once(self):
+        c = TTLCache(60)
+        calls = []
+        start = threading.Barrier(10)
+        results = []
+        results_lock = threading.Lock()
+
+        def fn():
+            calls.append(1)
+            time.sleep(0.05)  # long enough that the other callers pile up
+            return 42
+
+        def worker():
+            start.wait()
+            v = c.get_or_compute("a", fn)
+            with results_lock:
+                results.append(v)
+
+        threads = [threading.Thread(target=worker) for _ in range(10)]
+        for t in threads: t.start()
+        for t in threads: t.join()
+
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(results, [42] * 10)
+
+    def test_different_keys_run_in_parallel(self):
+        c = TTLCache(60)
+        # Both loaders signal entry, then block until the test releases them.
+        entered = threading.Semaphore(0)
+        gate = threading.Event()
+
+        def loader(name):
+            entered.release()
+            gate.wait()
+            return name
+
+        results = {}
+        res_lock = threading.Lock()
+
+        def worker(name):
+            v = c.get_or_compute(name, lambda n=name: loader(n))
+            with res_lock:
+                results[name] = v
+
+        t1 = threading.Thread(target=worker, args=("x",))
+        t2 = threading.Thread(target=worker, args=("y",))
+        t1.start(); t2.start()
+        # Both must be inside their loaders concurrently before we let them out.
+        self.assertTrue(entered.acquire(timeout=5))
+        self.assertTrue(entered.acquire(timeout=5))
+        gate.set()
+        t1.join(); t2.join()
+
+        self.assertEqual(results, {"x": "x", "y": "y"})
+
+    def test_exception_shared_and_not_cached(self):
+        c = TTLCache(60)
+        calls = []
+        start = threading.Barrier(4)
+        errors = []
+        err_lock = threading.Lock()
+
+        def fn():
+            calls.append(1)
+            time.sleep(0.05)  # force the other callers to wait on this computation
+            raise ValueError("boom")
+
+        def worker():
+            start.wait()
+            try:
+                c.get_or_compute("k", fn)
+            except ValueError as e:
+                with err_lock:
+                    errors.append(e)
+
+        threads = [threading.Thread(target=worker) for _ in range(4)]
+        for t in threads: t.start()
+        for t in threads: t.join()
+
+        self.assertEqual(len(errors), 4)
+        self.assertTrue(all(e.args == ("boom",) for e in errors))
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(len(c), 0)
+        # Next call tries again and succeeds this time.
+        self.assertEqual(c.get_or_compute("k", lambda: 7), 7)
+
+    def test_exception_followed_by_retry(self):
+        c = TTLCache(60)
+        calls = []
+        def fn():
+            calls.append(1)
+            if len(calls) == 1:
+                raise RuntimeError("first")
+            return "ok"
+
+        with self.assertRaises(RuntimeError):
+            c.get_or_compute("k", fn)
+        self.assertEqual(c.get_or_compute("k", fn), "ok")
+        self.assertEqual(len(calls), 2)
+        self.assertEqual(len(c), 1)
+
+
+class ExpiryTest(unittest.TestCase):
+    def make(self):
+        now = [0.0]
+        clock = lambda: now[0]
+        c = TTLCache(10, clock=clock)
+        return c, now
+
+    def test_expires_after_ttl(self):
+        c, now = self.make()
+        calls = []
+        def fn():
+            calls.append(1)
+            return len(calls)
+
+        self.assertEqual(c.get_or_compute("a", fn), 1)
+        now[0] = 9.9
+        self.assertEqual(c.get_or_compute("a", fn), 1)   # still fresh
+        now[0] = 10.1
+        self.assertEqual(c.get_or_compute("a", fn), 2)   # expired, recomputed
+        self.assertEqual(len(calls), 2)
+
+    def test_len_ignores_expired(self):
+        c, now = self.make()
+        c.get_or_compute("a", lambda: 1)
+        c.get_or_compute("b", lambda: 2)
+        self.assertEqual(len(c), 2)
+        now[0] = 10.1
+        self.assertEqual(len(c), 0)
+        now[0] = 5.0
+        self.assertEqual(len(c), 2)
+
+
 if __name__ == "__main__":
     unittest.main()
