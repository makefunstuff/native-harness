+import threading
+import unittest
+from ttlcache import TTLCache
+
+
+def FakeClock():
+    now = [0.0]
+
+    def clock():
+        return now[0]
+
+    def advance(dt):
+        now[0] += dt
+
+    return clock, advance
+
+
+class ConcurrencyTest(unittest.TestCase):
+    def test_loader_runs_once_for_many_callers(self):
+        c = TTLCache(60)
+        barrier = threading.Barrier(10)
+        calls = []
+        results = []
+        errors = []
+
+        def loader():
+            calls.append(1)
+            return 42
+
+        def caller():
+            barrier.wait()
+            try:
+                results.append(c.get_or_compute("k", loader))
+            except Exception as e:
+                errors.append(e)
+
+        threads = [threading.Thread(target=caller) for _ in range(10)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(errors, [])
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(results, [42] * 10)
+
+    def test_different_keys_do_not_block_each_other(self):
+        c = TTLCache(60)
+        release = threading.Event()
+        results = {}
+
+        started = threading.Event()
+
+        def loader_a():
+            started.set()
+            release.wait(5)
+            return "A"
+
+        def fetch_b():
+            results["b"] = c.get_or_compute("b", lambda: "B")
+
+        ta = threading.Thread(target=lambda: results.update(a=c.get_or_compute("a", loader_a)))
+        ta.start()
+        started.wait(5)  # "a" is now inside its (slow) computation
+        tb = threading.Thread(target=fetch_b)
+        tb.start()
+        # While "a" is still computing, "b" must complete on its own.
+        tb.join(5)
+        self.assertFalse(tb.is_alive(), "loader for 'b' blocked by 'a'")
+        self.assertEqual(results["b"], "B")
+        release.set()
+        ta.join(5)
+        self.assertFalse(ta.is_alive())
+        self.assertEqual(results["a"], "A")
+
+    def test_error_propagates_to_all_waiters_and_not_cached(self):
+        c = TTLCache(60)
+        barrier = threading.Barrier(3)
+        got_exc = []
+        got_val = []
+
+        def loader():
+            raise ValueError("boom")
+
+        def caller():
+            barrier.wait()
+            try:
+                got_val.append(c.get_or_compute("k", loader))
+            except ValueError as e:
+                got_exc.append(str(e))
+
+        threads = [threading.Thread(target=caller) for _ in range(3)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(got_val, [])
+        self.assertEqual(len(got_exc), 3)
+        self.assertTrue(all(e == "boom" for e in got_exc))
+
+        # Nothing cached: next call retries and succeeds.
+        self.assertEqual(c.get_or_compute("k", lambda: "ok"), "ok")
+
+
+class ExpiryTest(unittest.TestCase):
+    def test_expired_entry_is_recomputed(self):
+        clock, advance = FakeClock()
+        c = TTLCache(10, clock=clock)
+        calls = []
+
+        def loader():
+            calls.append(1)
+            return len(calls)
+
+        self.assertEqual(c.get_or_compute("k", loader), 1)
+        self.assertEqual(c.get_or_compute("k", loader), 1)
+        advance(10)  # at exactly ttl -> expired
+        self.assertEqual(c.get_or_compute("k", loader), 2)
+
+    def test_len_counts_only_live_entries(self):
+        clock, advance = FakeClock()
+        c = TTLCache(10, clock=clock)
+        c.get_or_compute("a", lambda: 1)
+        c.get_or_compute("b", lambda: 2)
+        self.assertEqual(len(c), 2)
+        advance(10)
+        self.assertEqual(len(c), 0)
+        c.get_or_compute("c", lambda: 3)
+        self.assertEqual(len(c), 1)
+
+    def test_default_cache_hit_still_works(self):
+        c = TTLCache(60)
+        calls = []
+        self.assertEqual(c.get_or_compute("a", lambda: calls.append(1) or 5), 5)
+        self.assertEqual(c.get_or_compute("a", lambda: calls.append(1) or 6), 5)
+        self.assertEqual(len(calls), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
