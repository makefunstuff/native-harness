+import re
 import sqlite3
+from datetime import datetime
+
+# The schema version every database is brought to by open_db.
+TARGET_VERSION = 2
+
+_DATE_RE = re.compile(r"\A\d{4}-\d{2}-\d{2}\Z")
+
+
+def _current_version(conn):
+    """Return the database's schema version, or 0 for a brand-new file.
+
+    A database from the previous release has a `tasks` table but no
+    `schema_version` table; it counts as version 1.
+    """
+    row = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name='schema_version'"
+    ).fetchone()
+    if row is None:
+        legacy = conn.execute(
+            "SELECT name FROM sqlite_master WHERE type='table' AND name='tasks'"
+        ).fetchone()
+        return 1 if legacy is not None else 0
+    return conn.execute("SELECT version FROM schema_version LIMIT 1").fetchone()[0]
+
+
+# SQL statements that bring a database from version step - 1 to version step.
+_STEP_STATEMENTS = {
+    1: [
+        "CREATE TABLE IF NOT EXISTS tasks ("
+        "id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+        "done INTEGER NOT NULL DEFAULT 0)"
+    ],
+    2: [
+        "ALTER TABLE tasks ADD COLUMN due_date TEXT"
+    ],
+}
+
+
+def _run_step(conn, step):
+    """Apply migration `step` (bringing the db to that version) in one transaction.
+
+    On failure the transaction is rolled back, leaving the database at the
+    previous version.
+    """
+    statements = _STEP_STATEMENTS.get(step)
+    if statements is None:
+        raise ValueError(f"no migration defined for version {step}")
+    try:
+        conn.execute("BEGIN")
+        conn.execute("CREATE TABLE IF NOT EXISTS schema_version (version INTEGER NOT NULL)")
+        for sql in statements:
+            conn.execute(sql)
+        existing = conn.execute("SELECT version FROM schema_version LIMIT 1").fetchone()
+        if existing is None:
+            conn.execute("INSERT INTO schema_version (version) VALUES (?)", (step,))
+        else:
+            conn.execute("UPDATE schema_version SET version = ?", (step,))
+        conn.execute("COMMIT")
+    except Exception:
+        conn.execute("ROLLBACK")
+        raise
 
 
 def open_db(path):
     conn = sqlite3.connect(path)
