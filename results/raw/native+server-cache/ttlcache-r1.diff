+class SingleFlightTest(unittest.TestCase):
+    def test_same_key_computed_once(self):
+        calls = []
+        c = TTLCache(60)
+
+        def loader():
+            calls.append(1)
+            return 42
+
+        results = []
+        errors = []
+        barrier = threading.Barrier(5)
+
+        def caller():
+            try:
+                results.append(c.get_or_compute("k", loader))
+            except Exception as e:
+                errors.append(e)
+
+        threads = [threading.Thread(target=caller) for _ in range(5)]
+        for t in threads:
+            t.start()
+            barrier.wait()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(calls, [1])
+        self.assertEqual(results, [42, 42, 42, 42, 42])
+        self.assertEqual(errors, [])
+
+    def test_different_keys_do_not_block_each_other(self):
+        c = TTLCache(60)
+        order = []
+        mu = threading.Lock()
+
+        def make_loader(name, delay):
+            def loader():
+                with mu:
+                    order.append(("start", name))
+                import time
+                time.sleep(delay)
+                with mu:
+                    order.append(("end", name))
+                return name
+            return loader
+
+        barrier = threading.Barrier(2)
+
+        def caller(name, delay):
+            barrier.wait()
+            c.get_or_compute(name, make_loader(name, delay))
+
+        # "slow" sleeps 0.3s; if "fast" were blocked by "slow" it would
+        # finish after "slow".
+        t1 = threading.Thread(target=caller, args=("slow", 0.3))
+        t2 = threading.Thread(target=caller, args=("fast", 0.0))
+        t1.start()
+        t2.start()
+        t1.join()
+        t2.join()
+
+        self.assertEqual(order, [("start", "slow"), ("start", "fast"),
+                                 ("end", "fast"), ("end", "slow")])
+
+    def test_waiters_get_the_stored_value(self):
+        calls = []
+        c = TTLCache(60)
+
+        def loader():
+            calls.append(1)
+            return "v"
+
+        barrier = threading.Barrier(2)
+
+        def caller():
+            barrier.wait()
+            return c.get_or_compute("k", loader)
+
+        t = threading.Thread(target=caller)
+        t.start()
+        # Make sure the second call happens while the first is in flight.
+        barrier.wait()
+        self.assertEqual(caller(), "v")
+        t.join()
+        self.assertEqual(calls, [1])
+
+
+class FailureTest(unittest.TestCase):
+    def test_exception_propagates_to_all_waiters_and_not_cached(self):
+        boom = RuntimeError("boom")
+        calls = []
+        c = TTLCache(60)
+
+        def loader():
+            calls.append(1)
+            raise boom
+
+        errors = []
+        barrier = threading.Barrier(3)
+
+        def caller():
+            try:
+                barrier.wait()
+                c.get_or_compute("k", loader)
+            except RuntimeError as e:
+                errors.append(e)
+
+        threads = [threading.Thread(target=caller) for _ in range(3)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        # All three callers got the same exception instance.
+        self.assertEqual(errors, [boom, boom, boom])
+
+        # Nothing was cached: a retry runs the loader again and succeeds.
+        self.assertEqual(len(c), 0)
+        self.assertEqual(c.get_or_compute("k", lambda: "recovered"), "recovered")
+        self.assertEqual(len(calls), 4)
+
+
+class FakeClock:
+    def __init__(self, start=0.0):
+        self.now = start
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+class ExpiryTest(unittest.TestCase):
+    def test_entry_expires_after_ttl(self):
+        clock = FakeClock()
+        c = TTLCache(10, clock=clock)
+        calls = []
+
+        def loader():
+            calls.append(1)
+            return f"v{len(calls)}"
+
+        self.assertEqual(c.get_or_compute("a", loader), "v1")
+        clock.advance(9.5)
+        self.assertEqual(c.get_or_compute("a", lambda: "x"), "v1")
+        self.assertEqual(len(calls), 1)
+        clock.advance(0.6)  # total 10.1 > ttl
+        self.assertEqual(c.get_or_compute("a", loader), "v2")
+        self.assertEqual(len(calls), 2)
+
+    def test_len_ignores_expired_entries(self):
+        clock = FakeClock()
+        c = TTLCache(10, clock=clock)
+        c.get_or_compute("a", lambda: 1)
+        c.get_or_compute("b", lambda: 2)
+        self.assertEqual(len(c), 2)
+        clock.advance(10)
+        self.assertEqual(len(c), 0)
+        # Expired entries are recomputed on access.
+        self.assertEqual(c.get_or_compute("a", lambda: 3), 3)
+        self.assertEqual(len(c), 1)
+
+    def test_expiration_is_relative_to_storage_not_first_fetch(self):
+        clock = FakeClock()
+        c = TTLCache(10, clock=clock)
+        clock.advance(100)
+        c.get_or_compute("a", lambda: 1)
+        clock.advance(9)
+        self.assertEqual(len(c), 1)
+        clock.advance(2)
+        self.assertEqual(len(c), 0)
+
+
 if __name__ == "__main__":
     unittest.main()
