+
+    rows = []
+    for n, r in enumerate(load(a.csv), start=1):
+        try:
+            qty = int(r["qty"])
+        except (ValueError, TypeError):
+            print(f"skipping row {n}: bad qty {r['qty']!r}", file=sys.stderr)
+            continue
+        try:
+            price = float(r["price"])
+        except (ValueError, TypeError):
+            print(f"skipping row {n}: bad price {r['price']!r}", file=sys.stderr)
+            continue
+        if qty < a.min_qty:
+            continue
+        rows.append({"name": r["name"], "qty": qty, "price": price})
+
+    rows.sort(key=lambda r: r["name"])
+
+    if a.format == "json":
+        print(json.dumps(rows))
+    else:
+        for r in rows:
+            print(f"{r['name']:<20} {r['qty']:>6} {r['price']:>10.2f}")
     return 0
 
 
