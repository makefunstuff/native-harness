+"""Reader for llama.cpp router preset files (INI-like, parsed by hand).
+
+Usage:
+    python3 presets.py FILE
+"""
+
+import sys
+
+
+def load_presets(path):
+    """Parse a preset file, returning {preset_name: merged keys} in file order.
+
+    Keys before the first [section] are global defaults inherited by every
+    section; a section's own key overrides the default. Raises ValueError
+    (with the 1-based line number) for a duplicate section or a non-blank,
+    non-comment line that is neither a section header nor contains '='.
+    """
+    defaults = {}
+    presets = {}
+    current = None
+
+    with open(path, "r", encoding="utf-8") as f:
+        for lineno, raw in enumerate(f, 1):
+            line = raw.rstrip("\n")
+            stripped = line.strip()
+            if not stripped:
+                continue
+            if stripped[0] in ("#", ";"):
+                continue
+            if stripped.startswith("[") and stripped.endswith("]"):
+                name = stripped[1:-1].strip()
+                if name in presets:
+                    raise ValueError(
+                        f"line {lineno}: duplicate section [{name}]"
+                    )
+                presets[name] = dict(defaults)
+                current = name
+                continue
+            if "=" not in stripped:
+                raise ValueError(f"line {lineno}: expected 'key = value' or [section]")
+            key, _, value = stripped.partition("=")
+            key = key.strip()
+            value = value.strip()
+            if current is None:
+                defaults[key] = value
+            else:
+                presets[current][key] = value
+
+    return presets
+
+
+def main(argv):
+    if len(argv) != 2:
+        print("usage: python3 presets.py FILE", file=sys.stderr)
+        return 2
+    presets = load_presets(argv[1])
+    for name, keys in presets.items():
+        ctx = keys.get("ctx-size", "-")
+        device = keys.get("device", "-")
+        split = keys.get("split-mode", "layer")
+        draft = "yes" if "spec-draft-model" in keys else "no"
+        print(f"{name} ctx={ctx} devices={device} split={split} draft={draft}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
