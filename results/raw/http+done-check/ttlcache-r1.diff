+import threading
+import time
 import unittest
 from ttlcache import TTLCache
 
@@ -10,6 +12,96 @@ class CacheTest(unittest.TestCase):
         self.assertEqual(c.get_or_compute("a", lambda: calls.append(1) or 6), 5)
         self.assertEqual(len(calls), 1)
 
+    def test_concurrent_same_key_computes_once(self):
+        calls = []
+        call_lock = threading.Lock()
+        c = TTLCache(60)
+
+        def loader():
+            with call_lock:
+                calls.append(1)
+            time.sleep(0.05)
+            return 42
+
+        threads = [threading.Thread(target=lambda: c.get_or_compute("k", loader))
+                   for _ in range(10)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(c.get_or_compute("k", lambda: 999), 42)
+
+    def test_different_keys_do_not_block(self):
+        c = TTLCache(60)
+        start = time.monotonic()
+
+        def slow(v):
+            def loader():
+                time.sleep(0.2)
+                return v
+            return loader
+
+        threads = [threading.Thread(target=lambda k=k: c.get_or_compute(k, slow(k)))
+                   for k in range(5)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+        self.assertLess(time.monotonic() - start, 0.6,
+                        "loaders for different keys should run in parallel")
+
+    def test_exception_shared_and_not_cached(self):
+        c = TTLCache(60)
+        boom = RuntimeError("db down")
+        results = []
+        results_lock = threading.Lock()
+
+        def bad():
+            raise boom
+
+        def attempt(i):
+            try:
+                v = c.get_or_compute("bad", bad)
+                with results_lock:
+                    results.append(("ok", i, v))
+            except RuntimeError as e:
+                with results_lock:
+                    results.append(("err", i, e is boom))
+
+        threads = [threading.Thread(target=attempt, args=(i,)) for i in range(8)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        self.assertEqual(len(results), 8)
+        for kind, _, same_exc in results:
+            self.assertEqual(kind, "err")
+            self.assertTrue(same_exc, "waiters must get the same exception")
+
+        # Nothing cached: the next call retries the loader.
+        self.assertEqual(c.get_or_compute("bad", lambda: "recovered"), "recovered")
+        self.assertEqual(len(c), 1)
+
+    def test_expiry_uses_injected_clock(self):
+        now = [0.0]
+        c = TTLCache(10, clock=lambda: now[0])
+        self.assertEqual(c.get_or_compute("a", lambda: 1), 1)
+        self.assertEqual(c.get_or_compute("b", lambda: 2), 2)
+        self.assertEqual(len(c), 2)
+
+        now[0] = 9.9
+        self.assertEqual(c.get_or_compute("a", lambda: 999), 1)   # still fresh
+        self.assertEqual(c.get_or_compute("b", lambda: 999), 2)   # still fresh
+
+        now[0] = 10.1
+        self.assertEqual(c.get_or_compute("a", lambda: 100), 100)  # expired -> recompute
+        self.assertEqual(len(c), 1)                                # b is expired
+
+        now[0] = 21.0
+        self.assertEqual(len(c), 0)
+
 
 if __name__ == "__main__":
     unittest.main()
