+"""Reader for llama.cpp router preset files (INI-like).
+
+Hand-rolled parser; deliberately not configparser because we need:
+  * values that contain '=' (split on the first '=' only)
+  * predictable duplicate-section errors with line numbers
+"""
+
+import sys
+
+
+def load_presets(path):
+    """Parse a preset file.
+
+    Returns a dict mapping preset (section) name -> merged key/value dict,
+    in file order.  Keys seen before the first section are global defaults
+    inherited by every section; a section's own key overrides the default.
+    All values are strings.
+    """
+    defaults = {}
+    presets = {}
+    current = None  # (name, dict)
+
+    with open(path, "r", encoding="utf-8") as f:
+        for lineno, raw in enumerate(f, 1):
+            line = raw.strip()
+            if not line or line[0] in "#;":
+                continue
+
+            if line.startswith("["):
+                if not line.endswith("]"):
+                    raise ValueError(f"line {lineno}: malformed section header: {line}")
+                name = line[1:-1].strip()
+                if name in presets:
+                    raise ValueError(f"line {lineno}: duplicate section [{name}]")
+                current = (name, dict(defaults))
+                presets[name] = current[1]
+                continue
+
+            if "=" not in line:
+                raise ValueError(
+                    f"line {lineno}: expected 'key = value' or [section]: {line}"
+                )
+
+            key, _, value = line.partition("=")
+            key = key.strip()
+            value = value.strip()
+            if not key:
+                raise ValueError(f"line {lineno}: empty key")
+            if current is None:
+                defaults[key] = value
+            else:
+                current[1][key] = value
+
+    return presets
+
+
+def main(argv):
+    if len(argv) < 2:
+        print("usage: presets.py FILE", file=sys.stderr)
+        return 2
+    presets = load_presets(argv[1])
+    for name, kv in presets.items():
+        ctx = kv.get("ctx-size", "-")
+        devices = kv.get("device", "-")
+        split = kv.get("split-mode", "layer")
+        draft = "yes" if "spec-draft-model" in kv else "no"
+        print(f"{name} ctx={ctx} devices={devices} split={split} draft={draft}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
