+import re
 import sqlite3
+from datetime import date, datetime
+
+TARGET_VERSION = 2
+
+# Version -> DDL to apply. Each is applied in its own transaction.
+MIGRATIONS = {
+    1: ("CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
+        "done INTEGER NOT NULL DEFAULT 0)"),
+    2: "ALTER TABLE tasks ADD COLUMN due_date TEXT",
+}
+
+_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+
+
+def _valid_date(value):
+    """Return True if value is a valid YYYY-MM-DD date string."""
+    return isinstance(value, str) and _DATE_RE.match(value) is not None \
+        and datetime.strptime(value, "%Y-%m-%d") is not None
+
+
+def _coerce_date(value):
+    """Accept a YYYY-MM-DD string or a datetime.date; return the ISO string."""
+    if isinstance(value, date) and not isinstance(value, datetime):
+        return value.isoformat()
+    return value
+
+
+def _current_version(conn):
+    tables = {r[0] for r in conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name IN (?, ?)",
+        ("schema_version", "tasks"))}
+    if "schema_version" in tables:
+        return conn.execute("SELECT version FROM schema_version").fetchone()[0]
+    if "tasks" in tables:
+        # Existing database from the current release: no version table, but
+        # it already has the version 1 schema.
+        return 1
+    return 0
 
 
 def open_db(path):
     conn = sqlite3.connect(path)
-    conn.execute("CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, "
-                 "done INTEGER NOT NULL DEFAULT 0)")
-    conn.commit()
+    current = _current_version(conn)
+    if "schema_version" not in {r[0] for r in conn.execute(
+            "SELECT name FROM sqlite_master WHERE type = 'table'")}:
+        conn.execute("CREATE TABLE schema_version (version INTEGER NOT NULL)")
+        conn.execute("INSERT INTO schema_version (version) VALUES (0)")
+        conn.commit()
+    for version in range(current + 1, TARGET_VERSION + 1):
+        with conn:  # one transaction per migration; failure stays at previous version
+            conn.execute(MIGRATIONS[version])
+            conn.execute("UPDATE schema_version SET version = ?", (version,))
     return conn
 
 
