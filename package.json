{
  "name": "pi-extras",
  "version": "0.1.0",
  "description": "Extensions that make pi work better, especially with local models",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makefunstuff/pi-extras.git"
  },
  "homepage": "https://github.com/makefunstuff/pi-extras#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "llama.cpp",
    "local-models"
  ],
  "files": [
    "extensions",
    "experimental/llama-native/extension",
    "experimental/llama-native/configs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/*/index.ts",
      "./experimental/llama-native/extension/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node test/run-unit.mjs",
    "smoke": "node test/smoke.mjs",
    "check": "scripts/check.sh"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  }
}
